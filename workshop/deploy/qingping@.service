[Unit]
Description=清平文坊 用户 %i
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/qingping/workshop
EnvironmentFile=/opt/qingping/workshop/deploy/env/%i.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
# 内测规模：每个进程实测常驻约 65MB，2核4G 跑 10-20 个宽裕
MemoryMax=512M

[Install]
WantedBy=multi-user.target
